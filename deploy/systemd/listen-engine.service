# The engine process for the Listening Observatory Workbench: many streams and
# analyses in one process, configured by the Workbench through the control API
# on /run/listen-engine/control.sock (mode 0660, group listen-engine; the
# Workbench's user joins that group). Memories and the saved configuration live
# in /var/lib/listen-engine. Runs beside the Observatory's listen-listener@
# instances, under its own user.
#
# Setup (root, once):
#   useradd --system --home-dir /var/lib/listen-engine --shell /usr/sbin/nologin listen-engine
#   usermod -aG listen-engine <the Workbench's user>
#   install -m 0755 listen-engine /usr/local/bin/listen-engine
#   install -m 0644 listen-engine.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now listen-engine
#
# Optional flags (e.g. -allow-host for an intranet test server, limits) in
# /etc/listen-engine/engine.env as ENGINE_ARGS="…".
[Unit]
Description=Listening Observatory engine for the Workbench
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=listen-engine
Group=listen-engine
EnvironmentFile=-/etc/listen-engine/engine.env
ExecStart=/usr/local/bin/listen-engine -socket /run/listen-engine/control.sock -memory-dir /var/lib/listen-engine/memory -state /var/lib/listen-engine/state.json $ENGINE_ARGS
Restart=always
RestartSec=5
RuntimeDirectory=listen-engine
RuntimeDirectoryMode=0750
StateDirectory=listen-engine
StateDirectoryMode=0750

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

# Resource caps for the whole engine (its analyses and every stream's ffmpeg);
# the per-member caps are the Workbench's. Raise with the number of streams.
Nice=10
CPUQuota=200%
MemoryMax=2G
TasksMax=512

[Install]
WantedBy=multi-user.target
