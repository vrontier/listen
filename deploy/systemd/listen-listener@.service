# Listening Observatory listener, one instance per source:
#   systemctl start listen-listener@<slug>
# Each instance reads /etc/listen/sources/<slug>.env (LISTEN_ARGS: port,
# input, options), generated by scripts/gen-sources.sh from
# site/_config/sources.json, and serves its events on 127.0.0.1:<port>.
[Unit]
Description=Listening Observatory listener (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=listen
Group=listen
EnvironmentFile=/etc/listen/sources/%i.env
# Optional, root-only (0600): LLM_API_KEY, NARRATOR_URL, NARRATOR_MODEL for
# the interpretation layer. Without it the narrator stays off.
EnvironmentFile=-/etc/listen/llm.env
ExecStart=/usr/local/bin/listen-listener -source %i -memory-dir /var/lib/listen/memory $LISTEN_ARGS
Restart=always
RestartSec=5
StateDirectory=listen

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# Resource caps (IONOS admin, 2026-10-01): keep a runaway decoder from
# starving the web stack or the local llama-server.
Nice=10
CPUQuota=100%
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
