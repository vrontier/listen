# The engine process the Workbench talks to, on a Unix socket.
#
# Until the engine process exists (built in the listen repository), this
# runs the stand-in from this repository, which serves the control API with
# made-up data and connects to no stream. Replacing it means changing
# ExecStart only; the socket stays where it is.
[Unit]
Description=Listening Observatory Workbench engine (stand-in)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=low
Group=low
RuntimeDirectory=low-engine
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/low-standin -socket /run/low-engine/control.sock -allow-private
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0007

Nice=10
CPUQuota=50%
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
